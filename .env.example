# Copy to .env for `npm run dev` against the `docker compose` services.
# Production sets the same variables on Render (Neon, Cloudflare R2, Mailtrap).

DATABASE_URL="postgresql://pencil:pencil@localhost:5433/pencil"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="pencil"
S3_ACCESS_KEY_ID="pencil"
S3_SECRET_ACCESS_KEY="pencil-secret"
S3_FORCE_PATH_STYLE="true"
# Where browsers load uploaded images from. Locally that's the MinIO bucket;
# in production, the R2 bucket's public URL (r2.dev or a custom domain).
S3_PUBLIC_URL="http://localhost:9000/pencil"

# Signs session cookies (JWT). Use a long random value in production:
#   openssl rand -base64 48
SESSION_SECRET="dev-only-session-secret-change-me-0123456789"

# Public address of the app, used in links inside emails. Set it to the
# deployed URL in production.
APP_URL="http://localhost:3000"

# Mailpit locally (no login); Mailtrap's SMTP host, port and credentials in production.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Pencil <no-reply@pencil.local>"

# Gemini API key for "Recommended for you" and "More like this" by meaning.
# Leave it blank and recommendations use tag overlap instead.
GEMINI_API_KEY=""

# OAuth client id (a "Web application" client in Google Cloud) for "Continue
# with Google". Only the id is needed, no secret: the browser gets an ID token
# from Google and the API checks it. Add the site's address as an authorized
# JavaScript origin. Leave it blank and the Google button is hidden.
GOOGLE_CLIENT_ID=""
