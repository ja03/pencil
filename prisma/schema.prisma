// Pencil schema. The `vector` extension (pgvector) is enabled by the first
// migration so later tickets can add `embedding vector(768)` columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased, so "Ahmad@x.com" and "ahmad@x.com" are one account.
  email           String    @unique
  username        String    @unique
  /// Null for accounts that only sign in with Google.
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// Copied into every session JWT. Bumping it invalidates all existing sessions.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("users")
}
