// Pencil schema. The `vector` extension (pgvector) is enabled by the first
// migration so later tickets can add `embedding vector(768)` columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased, so "Ahmad@x.com" and "ahmad@x.com" are one account.
  email           String    @unique
  username        String    @unique
  /// Null for accounts that only sign in with Google.
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// Copied into every session JWT. Bumping it invalidates all existing sessions.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  posts           Post[]
  likes           Like[]
  comments        Comment[]

  @@map("users")
}

model Post {
  id             String    @id @default(uuid(7)) @db.Uuid
  authorId       String    @db.Uuid
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// From the title at creation, with -2, -3… on collision. Never changes.
  slug           String    @unique
  title          String
  /// As the author wrote it. Null means cards and previews use `excerpt`.
  description    String?
  /// The first ~160 characters of the content's text, refreshed on every save.
  excerpt        String
  /// Tiptap JSON, already checked against the whitelist. Never raw HTML.
  content        Json
  /// Estimated from the content's word count, refreshed on every save.
  readingMinutes Int       @default(1)
  coverUrl       String?
  /// Null while the post is a draft. Set on first publish and never changed.
  publishedAt    DateTime?
  /// When the post was last edited after publishing; null if it never was.
  editedAt       DateTime?
  /// Soft delete: a deleted post is 404 everywhere.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tags           PostTag[]
  likes          Like[]
  comments       Comment[]

  @@index([authorId])
  /// The feed's keyset: newest published first, id breaks ties.
  @@index([publishedAt, id])
  @@map("posts")
}

/// A topic shared by every post that uses it. "React" and "react" are one tag.
model Tag {
  id        String    @id @default(uuid(7)) @db.Uuid
  /// Normalized: lowercase letters and numbers joined by hyphens (see contracts/tags.ts).
  name      String    @unique
  createdAt DateTime  @default(now())
  posts     PostTag[]

  @@map("tags")
}

/// A post's tags, at most 5, in the order the author gave them.
model PostTag {
  postId   String @db.Uuid
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId    String @db.Uuid
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  /// 0-based place in the author's list.
  position Int

  @@id([postId, tagId])
  /// Tag pages find posts by tag.
  @@index([tagId])
  @@map("post_tags")
}

/// A reader liking a post. The primary key is what makes a second like from
/// the same reader impossible, even under concurrent requests.
model Like {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  /// Counting a post's likes.
  @@index([postId])
  @@map("likes")
}

/// A reader's plain-text comment on a published post. Threads are one level
/// deep: a top-level comment has no parent, and a reply's parent is always a
/// top-level comment on the same post (the comment service enforces this).
model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  postId    String    @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String    @db.Uuid
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Null for a top-level comment; the top-level comment it answers for a reply.
  parentId  String?   @db.Uuid
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")
  /// Plain text, trimmed, at most 1000 characters.
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// A post's top-level comments, newest first, keyset-paged on (createdAt, id).
  @@index([postId, parentId, createdAt, id])
  /// A comment's replies, oldest first.
  @@index([parentId, createdAt, id])
  @@map("comments")
}
